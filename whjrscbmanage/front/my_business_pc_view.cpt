<C c="13" r="2" s="4">
<O>
<![CDATA[中止]]></O>
<PrivilegeControl/>
<NameJavaScriptGroup>
<NameJavaScript name="删除">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="row"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=row() - 1]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="col"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=col() - 1]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="approval_id"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=P3]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="status"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=I3]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[console.log(approval_id);
if(approval_id !== 'null'){
	alert("本业务正在经历审批流程，不可变更");
	}else if(status == "4"){
	alert("已过期的业务不允许中止");
	}else{
FR.Msg.confirm("提示","确认中止业务?",function(e){
	if(!e){return;}
	_g().getWidgetByCell(FR.columnRow2CellStr({
		col:col+1
		,row:row
	})).doClick()
})
	}]]></Content>
</JavaScript>
</NameJavaScript>
</NameJavaScriptGroup>
