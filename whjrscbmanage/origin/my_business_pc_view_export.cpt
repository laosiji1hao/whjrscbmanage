<IconName>
<![CDATA[export]]></IconName>
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="url"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=CONCATENATE($servletURL,"?format=excel&extype=simple&pp_cutpage=v&viewlet=",$relativeViewlet,"my_business_pc_view.cpt")]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[var customer_name = _g().getParameterContainer().getWidgetByName('customer_name').getValue() || "";
var biz_name = _g().getParameterContainer().getWidgetByName('biz_name').getValue() || "";

var REPORT_URL = url +'&customer_name=' + encodeURIComponent(customer_name) + '&biz_name=' + encodeURIComponent(biz_name)
console.log(REPORT_URL);
window.open(REPORT_URL);]]></Content>
</JavaScript>
