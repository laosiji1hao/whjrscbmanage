<O t="DSColumn">
<Attributes dsName="获取申报表已有业务信息" columnName="customer_no"/>
<Complex/>
<RG class="com.fr.report.cell.cellattr.core.group.FunctionGrouper"/>
<Parameters/>
<cellSortAttr/>
</O>
<PrivilegeControl/>
<Widget class="com.fr.form.ui.TextEditor">
<Listener event="stopedit" name="编辑结束1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[function v(name) {
    var w = _g().getWidgetByName(name);
    return w ? w.getValue() : "";
}
myFR.callCloud("226010", {
    custNo: v("customer_no")
}, function(data) {
    console.log(data);
    // ===== ECIF客户号处理 =====
    var currentEcifCustomerNo = v("ecif_customer_no");
    if (data.ecifCustomerNo === '' || data.ecifCustomerNo == null) {
        // 返回为空，不覆盖，仅提示
        if (currentEcifCustomerNo !== '' && currentEcifCustomerNo != null) {
            FR.Msg.alert('提示', '该客户编号查询的ECIF客户号不存在');
        }
    } else {
        // 返回有值，进行一致性校验
        if (currentEcifCustomerNo !== '' && currentEcifCustomerNo != null
                && currentEcifCustomerNo !== data.ecifCustomerNo) {
            FR.Msg.confirm('提示',
                'ECIF客户号已在页面上填写为【' + currentEcifCustomerNo + '】，与查询结果【' + data.ecifCustomerNo + '】不一致，是否以此为准？',
                function(btn) {
                    if (btn === 'ok') {
                        _g().getWidgetByName("ecif_customer_no").setValue(data.ecifCustomerNo);
                    }
                });
        } else {
            _g().getWidgetByName("ecif_customer_no").setValue(data.ecifCustomerNo);
        }
    }
    // ===== 客户名称处理 =====
    var currentCustomerName = v("customer_name");
    if (data.customerName === '' || data.customerName == null) {
        // 返回为空，不覆盖，仅提示
        if (currentCustomerName !== '' && currentCustomerName != null) {
            FR.Msg.alert('提示', '该客户编号查询的客户名称不存在');
        }
    } else {
        // 返回有值，进行一致性校验
        if (currentCustomerName !== '' && currentCustomerName != null
                && currentCustomerName !== data.customerName) {
            FR.Msg.confirm('提示',
                '客户名称已在页面上填写为【' + currentCustomerName + '】，与查询结果【' + data.customerName + '】不一致，是否以此为准？',
                function(btn) {
                    if (btn === 'ok') {
                        _g().getWidgetByName("customer_name").setValue(data.customerName);
                    }
                });
        } else {
            _g().getWidgetByName("customer_name").setValue(data.customerName);
        }
    }
}, null, true);]]></Content>
</JavaScript>
</Listener>
