<Widget class="com.fr.form.ui.TextEditor">
<Listener event="stopedit" name="编辑结束1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[ var supervise_account = _g().getWidgetByName("supervise_account").getValue();
myFR.callCloud("226014", {
        acctNo: supervise_account
    }, function(data) {
        if(data.status != "AS00"){
        	FR.Msg.alert('提示', '该账号不可用，查询结果为' + data.statusTxt);
        	_g().getWidgetByName("supervise_account").reset();
        	}
    },function(data){
    	FR.Msg.toast("账户不可用");
    	        	_g().getWidgetByName("supervise_account").reset();
    	},true);]]></Content>
</JavaScript>
</Listener>
