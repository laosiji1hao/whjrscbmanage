<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name=""/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Content>
<![CDATA[var exercise_flag = _g().getWidgetByName("exercise_flag").getValue();
if(exercise_flag == "1")//当是行权时，行权日期为到期日期；否则不填
{
	_g().getWidgetByName("exercise_date").setVisible(true);
	var mature_date = _g().getWidgetByName("mature_date").getValue();
	_g().getWidgetByName("exercise_date").setValue(mature_date);
	}else if(exercise_flag == "0"){
	_g().getWidgetByName("exercise_date").reset();
	_g().getWidgetByName("exercise_date").setVisible(false);
	}
	]]></Content>
</JavaScript>
</Listener>
