<WebWriteContent>
<Listener event="afterload">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="scrollTop"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$scrollTop]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="scrollLeft"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$scrollLeft]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[var st = parseInt(scrollTop);
if(st > 0){
	$("#frozen-center").scrollTop(st)
}

var sl = parseInt(scrollLeft);
if(sl > 0){
	$("#frozen-center").scrollLeft(sl)
}



var recoreSc = function(top,left){
	if(top != null && top > 0){
		_g().getParameterContainer().getWidgetByName("scrollTop").setValue(top)
	}
	if(left != null && left > 0){
		_g().getParameterContainer().getWidgetByName("scrollLeft").setValue(left)
	}
}
$(function () {
  $('#frozen-center').on('scroll', function () {
	const scrollTop = $(this).scrollTop();
	const scrollLeft = $(this).scrollLeft();
    if(!window.scrollTimer){
		window.clearTimeout(window.scrollTimer);
	}
	window.scrollTimer = window.setTimeout(function(){
		recoreSc(scrollTop,scrollLeft);
	},500);
  });
});]]></Content>
</JavaScript>
</Listener>
<Listener event="afterload">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
