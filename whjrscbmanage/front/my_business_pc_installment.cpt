<Content>
<![CDATA[var js_remark_flag = _g().getWidgetByName("js_remark_flag").getValue();
if(js_remark_flag == "0"){
	_g().getWidgetByName("js_remark").setValue("");
	_g().getWidgetByName("js_remark").setVisible(false); 
	}else{
	_g().getWidgetByName("js_remark").setVisible(true);
}]]></Content>
</JavaScript>
