<O t="DSColumn">
<Attributes dsName="查询当前业务信息" columnName="is_passage"/>
<Complex/>
<RG class="com.fr.report.cell.cellattr.core.group.FunctionGrouper"/>
<Parameters/>
<cellSortAttr/>
</O>
<PrivilegeControl/>
<Widget class="com.fr.form.ui.ComboBox">
<Listener event="stopedit" name="编辑结束1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="coupon_rate"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=J7]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="vat"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=J8]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="surcharge"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=J9]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[var is_passage = _g().getWidgetByName("is_passage").getValue();
if(is_passage == "0"){
	_g().getWidgetByName("passage_amount").setValue("");
	_g().getWidgetByName("passage_amount").setVisible(false);
	var rate_value = coupon_rate - vat - surcharge;
	console.log(rate_value.toFixed(6));  // 显示6位小数
_g().getWidgetByName("upper_storage_rate").setValue(parseFloat(rate_value.toFixed(6))); 
}else{
	_g().getWidgetByName("passage_amount").setVisible(true); 
}]]></Content>
</JavaScript>
</Listener>
