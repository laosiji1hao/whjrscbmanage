<C c="1" r="5" cs="2" s="3">
<O>
<![CDATA[变更申请]]></O>
<PrivilegeControl/>
<Widget class="com.fr.form.ui.FreeButton">
<Listener event="click" name="点击1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="id"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=B2]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="creator"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$fine_username]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="newCreator"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=C4]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="newOrgCode"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=B4]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[if (!myFR.validate()) {
    return
}
    function v(name) {
        var w = _g().getWidgetByName(name);
        return w ? w.getValue() : "";
    }
    
console.log(newCreator);
var newCreatorVal = v("person1").match(/\(([^)]A+)\)/)?.[1]A;
var newOrgNameVal = v("dept1").replace(/\([^)]A+\)/, "");
var newOrgCodeVal = v("dept1").match(/\(([^)]A+)\)/)?.[1]A;
console.log("newCreator:", newCreatorVal);                                                                                                                                                                                                                                                                                          console.log("newOrgCode:", newOrgCodeVal);
console.log("newOrgName:", newOrgNameVal);
myFR.callCloud("226008", {
    "businessId": id,
    "creator":creator,
    "newCreator" : newCreatorVal,
    "newOrgCode" : newOrgCodeVal,
    "newOrgName" : newOrgNameVal,
    "updaterType" : "0"
}, () => {
    window.parent.FR.closeDialog()
    window.parent.contentPane.parameterCommit()
    window.parent.FR.Msg.toast("申请更改客户经理审批中")
},null,true)]]></Content>
</JavaScript>
</Listener>
