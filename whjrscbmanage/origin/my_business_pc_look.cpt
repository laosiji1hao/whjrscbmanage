<C c="3" r="6" s="4">
<O t="DSColumn">
<Attributes dsName="查询当前业务信息" columnName="int_rating"/>
<Complex/>
<RG class="com.fr.report.cell.cellattr.core.group.FunctionGrouper"/>
<Parameters/>
<cellSortAttr/>
</O>
<PrivilegeControl/>
<Widget class="com.fr.form.ui.ComboBox">
<Listener event="stopedit" name="编辑结束1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[var int_rating = _g().getWidgetByName("int_rating").getValue();
	  var classOneRatings = ['AAA+', 'AAA', 'AAA-']A;
        // 第二类：AA+/AA/AA-/A+/A/A-/BBB+ -> customer_type = 1
       var classTwoRatings = ['AA+', 'AA', 'AA-', 'A+', 'A', 'A-', 'BBB+']A;
       if (classOneRatings.indexOf(int_rating) !== -1) {
            _g().getWidgetByName("customer_type").setValue(0);
        } else if (classTwoRatings.indexOf(int_rating) !== -1) {
            _g().getWidgetByName("customer_type").setValue(1);
        }]]></Content>
</JavaScript>
</Listener>
