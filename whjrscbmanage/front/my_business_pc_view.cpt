<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="url"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=CONCATENATE($servletURL,"?format=excel&extype=simple&pp_cutpage=v&viewlet=",$relativeViewlet,"my_business_pc_view_export.cpt")]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="creator"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$fine_username]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[var customer_name = _g().getParameterContainer().getWidgetByName('customer_name').getValue() || "";
var biz_name = _g().getParameterContainer().getWidgetByName('biz_name').getValue() || "";
var status = _g().getParameterContainer().getWidgetByName('status').getValue() || "";
var creator = creator;
var REPORT_URL = url +'&creator=' + encodeURIComponent(creator) +'&customer_name=' + encodeURIComponent(customer_name) + '&biz_name=' + encodeURIComponent(biz_name) + '&status=' + encodeURIComponent(status);
console.log(REPORT_URL);
window.open(REPORT_URL);]]></Content>
</JavaScript>
