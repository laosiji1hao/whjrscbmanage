<Parameters/>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[assign]]></DatabaseName>
</Connection>
<Query>
<![CDATA[select
       CONCAT(b.branch_name,'(',b.branch_no,')') as dept_name
from whoa_branch_info b
where status = '01';]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
