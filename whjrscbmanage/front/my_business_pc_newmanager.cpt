<TableData name="查询出所有的客户经理和机构" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters/>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[assign]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT
    CONCAT(w.user_name, '(', w.user_id, ')') AS name_with_id
FROM whfr_user w
WHERE w.status = '00']]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
<TableData name="查询机构号以及机构名称" class="com.fr.data.impl.DBTableData">
