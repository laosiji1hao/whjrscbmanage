<PrivilegeControl/>
<Widget class="com.fr.form.ui.TextEditor">
<Listener event="stopedit" name="编辑结束1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="currency"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=D11]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="orig_amount"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=H11]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[console.log(currency);
console.log(orig_amount);
if (currency == "人民币") {                                            
_g().getWidgetByName("rmb_amount").setValue(orig_amount);
_g().getWidgetByName("balance").setValue(orig_amount);  
} else if(currency == "美元") {
    _g().getWidgetByName("rmb_amount").setValue((orig_amount * 6.8).toFixed(2));
    _g().getWidgetByName("balance").setValue((orig_amount * 6.8).toFixed(2));
}]]></Content>
</JavaScript>
</Listener>
