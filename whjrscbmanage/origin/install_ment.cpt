<C c="3" r="7" s="0">
<PrivilegeControl/>
<Widget class="com.fr.form.ui.FreeButton">
<Listener event="click" name="点击1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[var list = []A;
var arr= _g().getWidgetsByName("installmentTime");
var arr1= _g().getWidgetsByName("installmentAmount");

 function getUrlParam(para) {
 	var params = location.search.substr(1).split('&');
 	for (var i = 0; i < params.length; i++) {
 		var pair = params[i]A.split('=');
 		if (decodeURIComponent(pair[0]A) == para) {
 			return decodeURIComponent(pair[1]A);
 		}
 	}
 	return null;
 }

//获取扩展单选按钮组ratio的控件对象数组
if (arr1[1]A != undefined) {
	for (var i = 0; i < arr1.length; i++) {
		var obj1 = {};
		console.log(arr1.length);
		if(arr1.length > 1){
		obj1['installmentTime']A = arr[i]A.getValue();
		obj1['installmentAmount']A = arr1[i]A.getValue();
		}else{
			obj1['installmentTime']A = arr.getValue();
			obj1['installmentAmount']A = arr1.getValue();
			console.log(obj1);
		}
		list.push(obj1);
	}
}else{
	var obj1 = {};
	obj1['installmentTime']A = arr.getValue();
	obj1['installmentAmount']A = arr1.getValue();
	list.push(obj1);
}
console.log(list);
var listStr = JSON.stringify(list);
console.log(listStr);
var result = list.map(function(item) {
    return "还款时间:" + item.installmentTime + ",还款金额:" + item.installmentAmount + ";";
}).join("");
console.log(result);
var type = getUrlParam('type');
if(type == '1'){
 window.parent._g().setCellValue("H18", result);
 window.parent._g().setCellValue("I18", listStr);
 }else if(type == '0'){
  window.parent._g().setCellValue("H15", result);
  window.parent._g().setCellValue("I15", listStr);
 	}
 window.parent.FR.closeDialog();]]></Content>
</JavaScript>
</Listener>
