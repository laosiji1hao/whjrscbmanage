<TableDataMap>
<TableData name="pagetool" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="pp_pagesize"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="biz_name"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="customer_name"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="fine_username"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$fine_username]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="status"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[whjrscbmanage]]></DatabaseName>
</Connection>
<Query>
<![CDATA[select count(*) as totalcnt
, ceiling(count(*) / ${pp_pagesize}) as totalpage
from (
select 
*
 from 
bus_bond_business
 where 1=1
 and status !="5"
  and status != '6'
  and creator = '${fine_username}'
${if(len(customer_name)=0,"","and customer_name = '"+customer_name+"'")}
${if(len(biz_name)=0,"","and biz_name = '"+biz_name+"'")}
${if(len(status)=0,"","and status  = '"+status+"'")}
)  as t1
]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
