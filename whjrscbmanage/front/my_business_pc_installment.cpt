<Widget class="com.fr.form.ui.FreeButton">
<Listener event="click" name="点击1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="id"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=D1]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[console.log(id);
    function v(name) {
        var w = _g().getWidgetByName(name);
        return w ? w.getValue() : "";
    }
    var inspect_freq
    if(v("customer_type") == "0" || v("customer_type") == "1"){
        inspect_freq = 3
    }else{
        inspect_freq = 1
    }
    myFR.callCloud("226006", {
        "businessId":      "",
        "bondCode":            v("bond_code"),
        "ecifCustomerNo":      v("ecif_customer_no"),
        "customerNo":          v("customer_no"),
        "customerName":        v("customer_name"),
        "bizName":             v("biz_name"),
        "bondType":            v("bond_type"),
        "greenTechFlag":       v("green_tech_flag"),
        "extRating":           v("ext_rating"),
        "extRatingDate":       v("ext_rating_date"),
        "ratingAgency":        v("rating_agency"),
        "intRating":           v("int_rating"),
        "intRatingDate":       v("int_rating_date"),
        "industry":            v("industry"),
        "customerType":        v("customer_type"),
        "startDate":           v("start_date"),
        "matureDate":          v("mature_date"),
        "currency":            v("currency"),
        "origAmount":          v("orig_amount"),
        "rmbAmount":           v("rmb_amount"),
        "balance":             v("balance"),
        "investRate":          v("invest_rate"),
        "transferRate":        v("transfer_rate"),
        "guaranteeInfo":       v("guarantee_info"),
        "installmentFlag":     v("installment_flag"),
        "installmentPlan":     v("installment_plan"),
        "ourBankUnderwrite":   v("our_bank_underwrite"),
        "agreedUsage":         v("agreed_usage"),
        "fundAccount":         v("fund_account"),
        "fundAccountFlag":     v("fund_account_flag"),
        "superviseAccount":     v("supervise_account"),
        "superviseAccountFlag":v("supervise_account_flag"),
        "drawdownCheck":       v("drawdown_check"),
        "exerciseFlag":        v("exercise_flag"),
        "exerciseDate":        v("exercise_date"),
        "remarkNumber":       v("remark_number"),
        "remark":              v("remark"),
        "jsRemark":            v("js_remark"),
        "jsRemarkFlag":        v("js_remark_flag"),
        "leadUnderwriter":     v("lead_underwriter"),
        "inspectFreq":         inspect_freq,
        "inspectorPost":      "客户经理"
    }, function(data) {
//        window.parent.FR.closeDialog();
//        window.parent.contentPane.parameterCommit();
        window.parent.FR.Msg.toast("创建分期业务信息审批中");
    },null,true);]]></Content>
</JavaScript>
