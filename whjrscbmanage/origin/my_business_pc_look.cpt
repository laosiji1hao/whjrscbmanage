<TableData name="查询当前业务的还款计划" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="id"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[whjrscbmanage]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT GROUP_CONCAT(
    CONCAT_WS(',',
        CONCAT('还款时间:', IFNULL(repayment_date, '无')),
        CONCAT('还款金额:', IFNULL(repayment_amount, '无'))
    ) SEPARATOR ';'
) AS repayment_info,
    JSON_ARRAYAGG(
        JSON_OBJECT(
            'installmentTime', DATE_FORMAT(repayment_date, '%Y-%m-%d'),
            'installmentAmount', CAST(repayment_amount AS UNSIGNED)
        )
    ) AS installment_list
FROM bus_bond_business bbb
LEFT JOIN bus_repayment_schedule b
    ON b.bond_code = bbb.bond_code COLLATE utf8mb4_general_ci
    AND b.status = '2'
WHERE bbb.id = '${id}';]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
