<TableDataMap>
<TableData name="pagetool" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="pp_pagesize"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="biz_name"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="customer_name"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="status"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="creator"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[whjrscbmanage]]></DatabaseName>
</Connection>
<Query>
<![CDATA[select count(*) as totalcnt
, ceiling(count(*) / ${pp_pagesize}) as totalpage
from (
select 
*
 from 
bus_bond_business
 where 1=1
 and status !="5"
  and status != '6'
${if(len(creator)=0,"and status != '0'"," and creator = '"+creator+"'")}
${if(len(customer_name)=0,"","and customer_name = '"+customer_name+"'")}
${if(len(biz_name)=0,"","and biz_name = '"+biz_name+"'")}
${if(len(status)=0,"","and status  = '"+status+"'")}
)  as t1
]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
<TableData name="金市业务" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="pp_pagesize"/>
<O>
<![CDATA[20]]></O>
</Parameter>
<Parameter>
<Attributes name="pp_pageno"/>
<O>
<![CDATA[1]]></O>
</Parameter>
<Parameter>
<Attributes name="biz_name"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="pp_cutpage"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="customer_name"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="status"/>
<O>
<![CDATA[3]]></O>
</Parameter>
<Parameter>
<Attributes name="creator"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[whjrscbmanage]]></DatabaseName>
</Connection>
<Query>
<![CDATA[select 
*,
CONCAT(w.user_name, '(', b.creator, ')') as related_name
 from 
bus_bond_business b
LEFT JOIN whfr_user w ON b.creator = w.user_id 
 where 1=1
 and b.status != '5'
  and b.status != '6'
${if(len(creator)=0,"and b.status != '0'"," and b.creator = '"+creator+"'")}
${if(len(customer_name)=0,"","and b.customer_name = '"+customer_name+"'")}
${if(len(biz_name)=0,"","and b.biz_name = '"+biz_name+"'")}
${if(len(status)=0,"","and b.status  = '"+status+"'")}
order by b.id desc
 ${if(len(pp_cutpage)=0,"limit "+(pp_pageno - 1) * pp_pagesize+", "+pp_pagesize,"")}]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
