<O>
<![CDATA[添加还款计划]]></O>
<PrivilegeControl/>
<Widget class="com.fr.form.ui.FreeButton">
<Listener event="click" name="点击1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="row"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=ROW()]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="col"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=COL()]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="bond_code"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=H4]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[var installment_flag = _g().getWidgetByName("installment_flag").getValue();
console.log(installment_flag);
if(installment_flag == "0"){
	alert("分期还款请选择是！");
	}else{
	myFR.dialog.create('./install_ment.cpt&row='+row+'&col='+col+'&type=1',{
		"bond_code":bond_code
		},'还款计划',1200,1000
	)
	}]]></Content>
</JavaScript>
</Listener>
<WidgetAttr aspectRatioLocked="false" aspectRatioBackup="-1.0" description="">
<MobileBookMark useBookMark="false" bookMarkName="" frozen="false" index="-1" oldWidgetName=""/>
<PrivilegeControl/>
</WidgetAttr>
<Text>
<![CDATA[添加还款计划]]></Text>
<Hotkeys>
