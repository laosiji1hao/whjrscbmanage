<C c="14" r="2">
<O>
<![CDATA[删除]]></O>
<PrivilegeControl/>
<Widget class="com.fr.form.ui.FreeButton">
<Listener event="click" name="删除">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="bond_code"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=D3]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="terminator"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$fine_username]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[if (!myFR.validate()) {
    return
}
myFR.callCloud("226009", {
    "bondCode": bond_code,
    "terminator":terminator,
    "updaterType" : "0"
}, () => {
    window.parent.FR.closeDialog()
    window.parent.contentPane.parameterCommit()
    window.parent.FR.Msg.toast("中止业务流程审批中")
},null,true);]]></Content>
</JavaScript>
</Listener>
