<Content>
<![CDATA[var fund_account_flag = _g().getWidgetByName("fund_account_flag").getValue();
console.log(fund_account_flag);
if(fund_account_flag == "0"){
	_g().getWidgetByName("fund_account").setValue("");
	_g().getWidgetByName("fund_account").setVisible(false); 
}else{
	_g().getWidgetByName("fund_account").setVisible(true); 
}]]></Content>
</JavaScript>
