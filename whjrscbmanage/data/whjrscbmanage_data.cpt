<WorkBook xmlVersion="20211223" releaseVersion="11.5.0">
<TableDataMap>
<TableData name="declare_list" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="p_operator"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_customer_name"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT b.id, b.biz_uuid, b.bond_code, b.customer_no, b.customer_name, b.biz_name, b.bond_type, b.green_tech_flag, b.status, b.create_time, b.update_time FROM whjrscbmanage.bus_bond_business b WHERE b.status IN (0, 2) AND b.creator = '${p_operator}' AND ('' = '${p_customer_name}' OR b.customer_name = '${p_customer_name}') ORDER BY b.id DESC]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="declare_customer_opt" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="p_operator"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT DISTINCT b.customer_name FROM whjrscbmanage.bus_bond_business b WHERE b.status IN (0, 2) AND b.creator = '${p_operator}' AND b.customer_name IS NOT NULL ORDER BY b.customer_name]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="get_business" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="p_biz_uuid"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT * FROM whjrscbmanage.bus_bond_business WHERE biz_uuid = '${p_biz_uuid}']]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="schedule_by_bond" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="p_bond_code"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT b.id, b.biz_uuid, b.bond_code, b.sort, b.repayment_date, b.repayment_amount, b.status, b.create_time, b.update_time FROM whjrscbmanage.bus_repayment_schedule b WHERE b.bond_code = '${p_bond_code}' AND b.status = 2 ORDER BY b.sort]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="schedule_of_business" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="p_biz_uuid"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT GROUP_CONCAT(CONCAT_WS(',', CONCAT('还款时间:', IFNULL(b.repayment_date,'无')), CONCAT('还款金额:', IFNULL(b.repayment_amount,'无'))) SEPARATOR ';') AS repayment_info, JSON_ARRAYAGG(JSON_OBJECT('installmentTime', DATE_FORMAT(b.repayment_date,'%Y-%m-%d'), 'installmentAmount', CAST(b.repayment_amount AS UNSIGNED))) AS installment_list FROM whjrscbmanage.bus_bond_business bbb LEFT JOIN whjrscbmanage.bus_repayment_schedule b ON b.bond_code = bbb.bond_code AND b.status = 2 WHERE bbb.biz_uuid = '${p_biz_uuid}']]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="config_get" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters/><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT * FROM whjrscbmanage.bus_upper_storage_config ORDER BY id LIMIT 1]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="pool_list_mine" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="p_operator"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_customer_name"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_biz_name"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_status"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_pageno"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_pagesize"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT * FROM ( SELECT b.id, b.biz_uuid, b.bond_code, b.ecif_customer_no, b.customer_no, b.customer_name, b.biz_name, b.bond_type, b.biz_type, b.green_tech_flag, b.ext_rating, b.ext_rating_date, b.rating_agency, b.int_rating, b.int_rating_date, b.industry, b.customer_type, b.alert_customer, b.start_date, b.mature_date, b.currency, b.orig_amount, b.rmb_amount, b.balance, b.invest_rate, b.transfer_rate, b.guarantee_info, b.breach_flag, b.five_level_class, b.fund_used_flag, b.fund_used_up, b.installment_flag, b.installment_plan, b.our_bank_underwrite, b.lead_underwriter, b.manage_line, b.dept, b.agreed_usage, b.fund_account, b.fund_account_flag, b.supervise_account, b.supervise_account_flag, b.drawdown_check, b.is_original_am, b.exercise_flag, b.exercise_date, b.remark, b.js_remark, b.js_remark_flag, b.inspect_freq, b.inspector_post, b.creator, b.org_code, b.org_name, b.status, b.termination_reason, b.create_time, b.update_time, b.remark_number, b.is_passage, b.passage_amount, b.upper_storage_rate, CONCAT(w.user_name, '(', b.creator, ')') AS related_name, wb.dept_name, ROW_NUMBER() OVER (ORDER BY b.id DESC) AS rn FROM whjrscbmanage.bus_bond_business b LEFT JOIN whjrscbmanage.whfr_user w ON b.creator = w.user_id LEFT JOIN whjrscbmanage.whoa_branch_info wb ON b.org_code = wb.branch_no WHERE b.creator = '${p_operator}' AND b.status != '5' AND b.status != '6' AND ('' = '${p_customer_name}' OR b.customer_name = '${p_customer_name}') AND ('' = '${p_biz_name}' OR b.biz_name LIKE CONCAT('%','${p_biz_name}','%')) AND ('' = '${p_status}' OR b.status = '${p_status}') ) t3 WHERE t3.rn > ('${p_pageno}' - 1) * '${p_pagesize}' AND t3.rn <= '${p_pageno}' * '${p_pagesize}']]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="pool_total_mine" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="p_operator"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_customer_name"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_biz_name"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_status"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT count(*) AS totalcnt FROM whjrscbmanage.bus_bond_business b WHERE b.creator = '${p_operator}' AND b.status != '5' AND b.status != '6' AND ('' = '${p_customer_name}' OR b.customer_name = '${p_customer_name}') AND ('' = '${p_biz_name}' OR b.biz_name LIKE CONCAT('%','${p_biz_name}','%')) AND ('' = '${p_status}' OR b.status = '${p_status}')]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="pool_list_all" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="p_customer_name"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_biz_name"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_pageno"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_pagesize"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT * FROM ( SELECT b.id, b.biz_uuid, b.bond_code, b.ecif_customer_no, b.customer_no, b.customer_name, b.biz_name, b.bond_type, b.biz_type, b.green_tech_flag, b.ext_rating, b.ext_rating_date, b.rating_agency, b.int_rating, b.int_rating_date, b.industry, b.customer_type, b.alert_customer, b.start_date, b.mature_date, b.currency, b.orig_amount, b.rmb_amount, b.balance, b.invest_rate, b.transfer_rate, b.guarantee_info, b.breach_flag, b.five_level_class, b.fund_used_flag, b.fund_used_up, b.installment_flag, b.installment_plan, b.our_bank_underwrite, b.lead_underwriter, b.manage_line, b.dept, b.agreed_usage, b.fund_account, b.fund_account_flag, b.supervise_account, b.supervise_account_flag, b.drawdown_check, b.is_original_am, b.exercise_flag, b.exercise_date, b.remark, b.js_remark, b.js_remark_flag, b.inspect_freq, b.inspector_post, b.creator, b.org_code, b.org_name, b.status, b.termination_reason, b.create_time, b.update_time, b.remark_number, b.is_passage, b.passage_amount, b.upper_storage_rate, CONCAT(w.user_name, '(', b.creator, ')') AS related_name, wb.dept_name, ROW_NUMBER() OVER (ORDER BY b.id DESC) AS rn FROM whjrscbmanage.bus_bond_business b LEFT JOIN whjrscbmanage.whfr_user w ON b.creator = w.user_id LEFT JOIN whjrscbmanage.whoa_branch_info wb ON b.org_code = wb.branch_no WHERE b.status != '0' AND b.status != '5' AND b.status != '6' AND ('' = '${p_customer_name}' OR b.customer_name = '${p_customer_name}') AND ('' = '${p_biz_name}' OR b.biz_name LIKE CONCAT('%','${p_biz_name}','%')) ) t4 WHERE t4.rn > ('${p_pageno}' - 1) * '${p_pagesize}' AND t4.rn <= '${p_pageno}' * '${p_pagesize}']]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="pool_total_all" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="p_customer_name"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_biz_name"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT count(*) AS totalcnt FROM whjrscbmanage.bus_bond_business b WHERE b.status != '0' AND b.status != '5' AND b.status != '6' AND ('' = '${p_customer_name}' OR b.customer_name = '${p_customer_name}') AND ('' = '${p_biz_name}' OR b.biz_name LIKE CONCAT('%','${p_biz_name}','%'))]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="pool_filter_opt" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters/><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT DISTINCT customer_name, biz_name FROM whjrscbmanage.bus_bond_business WHERE status != '5' AND status != '6' ORDER BY customer_name]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="audit_all" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters/><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[SELECT business_no AS bond_code, MIN(id) AS approval_id, SUBSTRING_INDEX(GROUP_CONCAT(flow_code ORDER BY id DESC), ',', 1) AS flow_code FROM whjrscbmanage.iassist_flow_data WHERE approval_status = 0 GROUP BY business_no]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="manager_options" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters/><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[assign]]></DatabaseName></Connection><Query><![CDATA[SELECT CONCAT(w.user_name, '(', w.user_id, ')') AS name_with_id FROM assign.whfr_user w WHERE w.status = '00' ORDER BY w.user_id]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="org_options" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters/><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[assign]]></DatabaseName></Connection><Query><![CDATA[SELECT CONCAT(b.branch_name, '(', b.branch_no, ')') AS dept_name FROM assign.whoa_branch_info b WHERE b.status = '01' ORDER BY b.branch_no]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="upper_config_update" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="p_id"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_vat"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_surcharge"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="p_updater"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[CALL whjrscbmanage.sp_upper_storage_config_update('${p_id}', '${p_vat}', '${p_surcharge}', '${p_updater}')]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData></TableDataMap>
